PEACLOUD_ENV=production
PEACLOUD_ALLOWED_ORIGINS=https://peacloud.example.com
PEACLOUD_TRUST_PROXY_HEADERS=true
PEACLOUD_DOCS_ENABLED=false
# Cloud credentials should use provider-native short-lived identity methods.
PEACLOUD_AUTH_MODE=dev-header
PEACLOUD_OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
PEACLOUD_OIDC_AUDIENCE=api://YOUR_PEACLOUD_APP_ID
PEACLOUD_DATABASE_URL=postgresql+psycopg://peacloud:CHANGE_ME@postgres:5432/peacloud
PEACLOUD_OIDC_JWKS_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/discovery/v2.0/keys
PEACLOUD_RATE_LIMIT=120
PEACLOUD_RATE_WINDOW_SECONDS=60
PEACLOUD_SECRET_BACKEND=environment
PEACLOUD_AUDIT_FILE=/tmp/peacloud-audit.jsonl
# For Azure secret backend: AZURE_KEY_VAULT_URL=https://YOUR_VAULT.vault.azure.net
PEACLOUD_REDIS_URL=redis://redis:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
